<!-- A MAVEN SETTINGS FILE TO BE USED IN CI -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">

    <!-- Top-level mirrors: Maven only supports <mirrors> as a direct child of <settings>.
         Nesting <mirrors> inside a <profile> is silently ignored, so the proxy was never active.
         This mirror (id "nexus-proxy") authenticates using the "nexus-proxy" server below. -->
    <mirrors>
        <mirror>
            <id>nexus-proxy</id>
            <url>${env.MAVEN_PROXY_URL}</url>
            <mirrorOf>central</mirrorOf>
        </mirror>
    </mirrors>

    <!-- Plugin Groups: enables prefix-based plugin resolution (e.g., "cyclonedx:makeBom").
         Without this, Maven only checks org.apache.maven.plugins and org.codehaus.mojo,
         and Nexus proxy 500-errors on plugin-group maven-metadata.xml for other groups. -->
    <pluginGroups>
        <pluginGroup>org.apache.maven.plugins</pluginGroup>
        <pluginGroup>org.codehaus.mojo</pluginGroup>
        <pluginGroup>org.apache.archetype</pluginGroup>
        <pluginGroup>org.cyclonedx</pluginGroup>
        <pluginGroup>org.graalvm.buildtools</pluginGroup>
    </pluginGroups>

    <!-- Server Configuration -->
    <servers>
        <!-- Server configuration for GitHub -->
        <server>
            <id>github</id>
            <username>${env.GITHUBACTOR}</username>
            <password>${env.GITHUBTOKEN}</password>
        </server>
        <server>
            <id>githubpages</id>
            <username>git</username>
            <configuration>
                <scmVersionType>branch</scmVersionType>
                <scmVersion>gh-pages</scmVersion>
            </configuration>
        </server>
        <server>
            <id>dockerhub</id>
            <username>${env.DOCKERHUB_TOKEN}</username>
            <password>${env.DOCKERHUB_TOKEN}</password>
        </server>
        <server>
            <id>ossrh</id>
            <username>${env.MAVEN_CENTRAL_USERNAME}</username>
            <password>${env.MAVEN_CENTRAL_TOKEN}</password>
        </server>
        <server>
            <id>nexus-proxy</id>
            <username>${env.NEXUS_USERNAME}</username>
            <password>${env.NEXUS_PASSWORD}</password>
        </server>
    </servers>

    <!-- Profile Configuration -->
    <profiles>
        <!-- Profile for Sonar -->
        <profile>
            <id>sonar</id>
            <properties>
                <sonar.host.url>${env.SONAR_URL}</sonar.host.url>
                <sonar.login>${env.SONAR_TOKEN}</sonar.login>
            </properties>
        </profile>

        <!-- Profile for GitHub -->
        <profile>
            <id>github</id>
            <repositories>
                <repository>
                    <id>github</id>
                    <url>https://maven.pkg.github.com/${env.GITHUBORG}/*</url>
                    <snapshots>
                        <enabled>true</enabled>
                    </snapshots>
                </repository>
            </repositories>
            <pluginRepositories>
                <pluginRepository>
                    <id>github</id>
                    <url>https://maven.pkg.github.com/${env.GITHUBORG}/*</url>
                    <snapshots>
                        <enabled>true</enabled>
                    </snapshots>
                </pluginRepository>
            </pluginRepositories>
        </profile>
    </profiles>

    <!-- Active Profiles -->
    <activeProfiles>
        <activeProfile>github</activeProfile>
    </activeProfiles>

</settings>
